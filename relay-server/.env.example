# 로컬 테스트용 예시 - 실제 값은 절대 커밋하지 말 것 (.gitignore 처리됨)
# Render 배포 시에는 이 파일 대신 Render 대시보드 Environment 탭에 직접 등록.
KIS_APP_KEY=여기에_실전투자_App_Key
KIS_APP_SECRET=여기에_실전투자_App_Secret
ALLOWED_ORIGIN=https://bjkim-pixel.github.io
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_SERVICE_KEY=
DAILY_SUMMARY_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── 매매 보안 기반 (1단계) — 모두 Render Environment 에 등록 ──
ALLOWED_EMAIL=내_로그인_이메일          # 이 계정만 매매 API 사용 가능
SUPABASE_ANON_KEY=                      # (이미 코드에 기본값 있음) 사용자 토큰 검증용
TRADE_PIN_HASH=                         # 사이트의 pin-hash.html 에서 만든 값(pbkdf2$...)
TRADING_ENABLED=0                       # 1 이어야 매매 기능 동작 (0 = 전체 정지)
REAL_TRADING_ENABLED=0                  # 1 이어야 실전 매매 가능 (가상만 쓰려면 0)
# 가상매매(자체 체결 시뮬레이터)는 TRADING_ENABLED=1 이면 동작합니다. 수수료·세금은 기본 무시(0), 켜려면 아래 % 를 지정
# PAPER_FEE_BUY_PCT=0
# PAPER_FEE_SELL_PCT=0
# VIRTUAL_MAX_ORDER_KRW=5000000  VIRTUAL_MAX_DAILY_KRW=20000000  VIRTUAL_MAX_POSITIONS=10
MAX_ORDER_KRW=500000                    # 실전 1회 주문 한도
MAX_DAILY_KRW=2000000                   # 실전 1일 누적 매수 한도
MAX_POSITIONS=5                         # 실전 동시 보유 종목 수
TRADE_HOURS=08:00-20:00                 # 신규 매수 허용 시간대(KST)
# 8단계(NXT·시간외): 시간외 손절 지정가 호가 수·재주문 간격, SOR 대신 거래소 직접 지정
# STOP_LIMIT_TICKS=5  STOP_RETRY_SEC=20  TRADE_NO_SOR=0
NTFY_TOPIC=                             # (선택) ntfy 폰 알림 주제. 비우면 텔레그램·웹푸시만

# ── 실전매매(6단계) — 아래 셋이 모두 있어야 실제 주문이 나갑니다. 5단계 가상 운영(2주, 오류 0건) 통과 후에 켜세요 ──
# REAL_TRADING_ENABLED=1
# KIS_ACCOUNT_NO=12345678-01        # 계좌번호 8자리-상품코드 2자리 (KIS_ACCOUNT_PRDT 로 따로 넣어도 됨). 로그·응답에 남기지 않음
# MAX_ORDER_KRW=500000  MAX_DAILY_KRW=2000000  MAX_POSITIONS=5   # 실전 한도(기본값)
